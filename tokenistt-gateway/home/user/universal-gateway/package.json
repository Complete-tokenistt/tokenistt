{
  "name": "universal-gateway",
  "version": "1.0.0",
  "description": "Multi-provider AI Gateway that normalizes OpenAI, Anthropic, AWS Bedrock, and Azure OpenAI APIs",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:node": "node --loader tsx src/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openai",
    "anthropic",
    "bedrock",
    "azure",
    "ai",
    "gateway",
    "proxy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
