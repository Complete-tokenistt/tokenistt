{
  "name": "tokenistt",
  "version": "0.1.0",
  "description": "Command-line client for a self-hosted Tokenistt gateway: authenticate, inspect AI usage and cost, test policies.",
  "keywords": ["tokenistt", "cli", "llm", "ai", "cost", "usage", "governance"],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tokenistt": "bin/tokenistt.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-force-exit --test-timeout=60000 tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Complete-tokenistt/tokenist-main.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/Complete-tokenistt/tokenist-main/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/Complete-tokenistt/tokenist-main/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
