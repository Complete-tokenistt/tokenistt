{
  "name": "tokenistt",
  "version": "0.1.0",
  "description": "Open-source AI cost visibility and governance, with developer intelligence for your repositories.",
  "keywords": [
    "tokenistt",
    "cli",
    "llm",
    "ai",
    "cost",
    "usage",
    "governance"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tokenistt": "bin/tokenistt.js"
  },
