{
  "name": "tokenistt-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tokenistt — open-source AI cost visibility and governance gateway",
  "workspaces": [
    "apps/*",
    "packages/finops-middleware",
    "packages/sdk-ts",
    "packages/analytics/consumer",
    "packages/credential-manager",
    "packages/shadow-ai-scanner"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:gateway": "npm run build --workspace=apps/gateway",
    "dev:gateway": "npm run dev --workspace=apps/gateway",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "typecheck:gateway": "npm run typecheck --workspace=apps/gateway"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "postcss": "^8.5.16"
  }
}
