{
  "name": "universal-gateway",
  "version": "1.0.0",
  "description": "Multi-provider AI Gateway that normalizes OpenAI, Anthropic, AWS Bedrock, and Azure OpenAI APIs",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:node": "node --loader tsx src/server.ts",
    "test": "tsx --test --test-force-exit --test-timeout=60000 src/tests/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "keywords": [
    "openai",
    "anthropic",
    "bedrock",
    "azure",
    "ai",
    "gateway",
    "proxy"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1081.0",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "kafkajs": "^2.2.4"
  }
}
