# Required in production (gateway refuses to start without them)
ADMIN_SECRET=            # >=32 chars; guards /v1/admin/*
MASTER_KEY=              # 64 hex chars; AES-256-GCM for BYOK keys
ENCRYPTION_KEY=          # 64 hex chars
DATABASE_URL=postgres://tokenistt:CHANGE_ME@localhost:5432/tokenistt
REDIS_URL=redis://localhost:6379
# Optional
PORT=3000
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
CORS_ORIGINS=http://localhost:3001
