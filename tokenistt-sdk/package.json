{
  "name": "@tokenistt/sdk",
  "version": "0.1.0",
  "description": "Drop-in OpenAI SDK replacement that routes to the Tokenistt gateway, with auto-retry, cost tracking, budget warnings, and per-user attribution.",
  "keywords": [
    "openai",
    "sdk",
    "llm",
    "gateway",
    "cost-tracking",
    "budget",
    "tokenistt",
    "ai"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/cjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-cjs.json && node scripts/finalize.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
