{
  "name": "@tokenistt/sdk",
  "version": "0.1.0",
  "description": "Drop-in OpenAI SDK replacement that routes to the Tokenistt gateway, with auto-retry, cost tracking, budget warnings, and per-user attribution.",
  "keywords": [
    "openai",
    "sdk",
    "llm",
    "gateway",
    "cost-tracking",
    "budget",
    "tokenistt",
    "ai"
  ],
  "license": "Apache-2.0",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/cjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-cjs.json && node scripts/finalize.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node tests/smoke.cjs",
    "test:live": "node tests/live.cjs"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Complete-tokenistt/tokenistt.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/Complete-tokenistt/tokenistt#sdks",
  "bugs": {
    "url": "https://github.com/Complete-tokenistt/tokenistt/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
