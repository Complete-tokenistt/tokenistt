{
  "name": "finops-middleware",
  "version": "1.0.0",
  "description": "FinOps Attribution Middleware for virtual key management, budget enforcement, and rate limiting",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "finops",
    "middleware",
    "budget",
    "rate-limiting",
    "api-gateway",
    "virtual-keys"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^5.2.1",
    "ioredis": "^5.6.1",
    "pg": "^8.23.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
