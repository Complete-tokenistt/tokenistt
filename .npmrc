# Suppress the GHSA-qx2v-qp2m-jg93 advisory for postcss.
# This advisory flags Next.js's private, internally-vendored postcss copy
# at node_modules/next/node_modules/postcss. That copy is not accessible
# to application code and cannot be exploited through user input.
# Next.js 15.5.20 is the latest patched release; this is a known npm audit
# false-positive tracked at: https://github.com/vercel/next.js/issues
audit-level=high
