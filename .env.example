# Copy to .env, then:  docker compose up --build
# Generate each secret with:  openssl rand -hex 32

POSTGRES_PASSWORD=
ADMIN_SECRET=          # operator access to the management API
MASTER_KEY=            # encrypts BYOK provider keys (>= 32 chars)
ENCRYPTION_KEY=        # >= 32 chars
JWT_SECRET=            # signs dashboard sessions; shared by dashboard + gateway (>= 32 chars)

# Provider keys the gateway itself may use (or add per-org BYOK keys through the API)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

# Optional
AUTH_MODE=open         # open = no login (try it locally); jwt = require sign-in
SLACK_WEBHOOK_URL=
CORS_ORIGINS=http://localhost:3001
METRICS_TOKEN=
MOCK_PROVIDER=1        # set to 1 to try the stack with the offline "mock:" provider
# Host ports (change if something local already uses them)
GATEWAY_PORT=3000
DASHBOARD_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
