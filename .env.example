# Easiest: node scripts/setup.mjs (generates all of these). Or copy to .env, fill in, then:
#   docker compose up --build -d
# Generate each secret with:  openssl rand -hex 32

POSTGRES_PASSWORD=
REDIS_PASSWORD=        # hex only (it is embedded in REDIS_URL)
METRICS_TOKEN=         # bearer token for GET /metrics
ADMIN_SECRET=          # operator access to the management API
MASTER_KEY=            # encrypts BYOK provider keys (>= 32 chars)
ENCRYPTION_KEY=        # >= 32 chars
JWT_SECRET=            # signs dashboard sessions; shared by dashboard + gateway (>= 32 chars)

# Provider keys the gateway itself may use (or add per-org BYOK keys through the API)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

# Optional
AUTH_MODE=jwt          # jwt = require sign-in (default); open = no login, throwaway local installs only
BIND_ADDR=127.0.0.1    # interface for the gateway/dashboard ports; 0.0.0.0 only behind a TLS proxy
# TRUST_PROXY=1        # number of reverse proxies in front of the gateway (so rate limits see real client IPs)
# DOMAIN=tokenistt.example.com   # for: docker compose --profile tls up -d (also set PUBLIC_GATEWAY_URL, CORS_ORIGINS, TRUST_PROXY=1)
# TRANSACTIONS_RETENTION_MONTHS=24   # opt-in: drop transaction partitions older than N months (default: keep forever)
# COOKIE_SECURE=false  # only if serving the dashboard over plain HTTP on a trusted network
SLACK_WEBHOOK_URL=
CORS_ORIGINS=http://localhost:3001
MOCK_PROVIDER=1        # set to 1 to try the stack with the offline "mock:" provider
# Host ports (change if something local already uses them)
GATEWAY_PORT=3000
DASHBOARD_PORT=3001
